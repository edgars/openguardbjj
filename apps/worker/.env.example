# --- obrigatórias ---
# Mesma connection string do Neon usada pelo app web (pooled ou direta).
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Token read-write do MESMO Blob Store do projeto Vercel (Storage → Blob → .env.local / Tokens).
# Fica só no worker/servidor — nunca no navegador.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# private (recomendado) | public — deve bater com o tipo do store e com o app web.
BLOB_ACCESS=private

# --- worker ---
# WORKER_ID=macbook-edgar
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=120
# WORKER_TMP_DIR=/tmp/bjj-media-worker

# --- limites ---
MAX_DURATION_SECONDS=10800
MAX_FILE_SIZE_MB=2048
# Guardar audio.mp3 no Blob (permite retranscrever sem baixar o MP4)
STORE_AUDIO=true

# --- transcrição (faster-whisper local, sem API paga) ---
# tiny | base | small | medium | large-v3  (maior = melhor e mais lento)
WHISPER_MODEL=small
# vazio = detecção automática; ex.: pt, en
WHISPER_LANGUAGE=
WHISPER_COMPUTE_TYPE=int8
# WHISPER_PYTHON=/caminho/para/python  (padrão: apps/worker/.venv/bin/python)

# --- análise opcional com LLM. Vazio = só classificador por palavras-chave + descrição ---
# LLM opcional (API compatível com OpenAI) para deduzir técnicas pelo movimento descrito.
# Groq (grátis, sem cartão — console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# Ollama local: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:30b-a3b (sem LLM_API_KEY)
# OpenRouter: https://openrouter.ai/api/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- binários (padrão: PATH) ---
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
