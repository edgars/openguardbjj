# Neon (Vercel Marketplace) — injetado automaticamente ao conectar a integração
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob — em produção na Vercel o SDK autentica via OIDC (BLOB_STORE_ID).
# Localmente: `vercel env pull` ou um token read-write. Nunca use prefixo NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
BLOB_ACCESS=private
PLAYBACK_URL_TTL_SECONDS=14400

# Autenticação (Clerk). Chaves em dashboard.clerk.com → API Keys.
# Em *.vercel.app use as chaves de Development (pk_test_/sk_test_); produção do Clerk exige domínio próprio.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Super admin: conta Clerk com este e-mail VERIFICADO gerencia a biblioteca. Demais contas = "user".
SUPER_ADMIN_EMAIL=edgar@skalena.com

# Limites de upload direto (Client Upload)
MAX_UPLOAD_MB=4096

# Estimativa de custo na página Storage (confira a tabela de preços atual do Vercel Blob)
BLOB_STORAGE_PRICE_PER_GB_MONTH=0.023
BLOB_TRANSFER_PRICE_PER_GB=0.05
EXPECTED_PLAYBACK_GB_MONTH=5
